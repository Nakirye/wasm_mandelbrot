{
  "name": "wasm-mandelbrot",
  "version": "1.0.0",
  "description": "Mandelbrot-Benchmark: JavaScript vs. WebAssembly (AssemblyScript)",
  "type": "module",
  "scripts": {
    "build": "asc assembly/index.ts --target release && asc assembly/particles.ts --target release --outFile build/particles.wasm --textFile build/particles.wat",
    "build:debug": "asc assembly/index.ts --target debug",
    "start": "node server.js",
    "bench": "node bench-node.mjs",
    "bench:cold": "node bench-cold.mjs",
    "bench:particles": "node --expose-gc bench-particles.mjs"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.20"
  }
}
